{
  "name": "localdrop",
  "version": "1.0.0",
  "description": "Local file transfer tool",
  "main": "server/index.js",
  "bin": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "build": "pkg . --targets node18-win-x64 --output dist/LocalDrop.exe --icon LocalDrop.ico"
  },
 "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/ws/**/*",
      "LocalDrop.ico"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "ip": "^1.1.8",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.20.0"
  }
}
